# Copy to .env and edit. Never commit .env.
POSTGRES_USER=barrecon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barrecon
# Password of the first "admin" login, used only when the database has no users yet.
# After that, logins live in the database: Setup -> Users (change it under My account).
ADMIN_PASSWORD=change-me
# The platform console (/platform): tenants, limits, usage and reports. Its first login is made once, at the first
# start with this version: PLATFORM_ADMIN_USERNAME (default "platform") with PLATFORM_ADMIN_PASSWORD (empty: ADMIN_PASSWORD).
# Add more platform admins, and change the password, inside the console.
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=
# Name of the tenant an existing single-bar database becomes (rename it in the console any time)
FIRST_TENANT_NAME=First tenant
# Random string used to sign the session cookie (any long value)
SESSION_SECRET=change-me-to-a-long-random-string
# It also keys the audit log's tamper check: changing it makes "Check for tampering" report old entries as broken.
# It encrypts admins' authenticator secrets too: changing it means every admin sets up two-step login again.
# And each business's Swype password: changing it means entering those again under Setup -> Businesses.
# Behind HTTPS reverse proxy: COOKIE_SECURE=true and TRUST_PROXY=true (add both to docker-compose.yml's environment).
# Host folder for nightly pg_dump files
BACKUP_DIR=./backups
# Port the portal listens on (localhost only by default)
PORT=8080
TZ=America/Vancouver
# Claude API key for reading uploaded store receipts (Deliveries). Leave empty to enter receipts by hand.
ANTHROPIC_API_KEY=
# One key for every tenant; the platform console meters tokens per tenant and business and estimates the cost from
# list prices. Override or add prices (USD per million tokens, [input, output]): AI_PRICES={"claude-opus-5-5": [4, 20]}
# Two-step login (authenticator app) is optional: anyone can turn it on under My account.
# true: admins must set it up at their next password login.
ADMIN_MFA_REQUIRED=false
# Email for invites, password resets and two-step recovery. Leave MAILGUN_* and SMTP_HOST empty for no email.
# PUBLIC_URL is the address people open the portal at; links in emails are built from it.
# MAIL_FROM must be an address on your Mailgun domain (e.g. postmaster@mg.example.com).
PUBLIC_URL=
# Mailgun HTTP API (used instead of SMTP when key and domain are set). EU domains: https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net
# Or plain SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=
